/*
 * SPDX-License-Identifier: Apache-2.0
 *
 * PMW3901 bring-up overlay (SPI2 pinmux)
 *
 * Pin mapping (riskybird PCB):
 * - SCK:  GPIO6
 * - MOSI: GPIO7
 * - MISO: GPIO18
 * - CS:   GPIO19  (handled as a normal GPIO in software; not hardware CSEL)
 * - RST:  GPIO2   (optional, active-low)
 * - LED:  GPIO3   (optional, active-low)
 *
 * This overlay reconfigures SPI2 pinmux to match the PMW3901 wiring.
 */

/* Route console to the ESP32-C6 built-in USB Serial/JTAG so the chip-ID result prints on the
 * riskybird USB-C port (/dev/ttyACM*). Without this the hpcore board sends console to UART0
 * physical pins, which are not broken out -- the PMW3901 test output would go nowhere. */
/ {
	chosen {
		zephyr,console = &usb_serial;
		zephyr,shell-uart = &usb_serial;
	};
};

&usb_serial {
	status = "okay";
};

/* Disable I2C0 to avoid pin conflict with GPIO6/GPIO7 (board default I2C0). */
&i2c0 {
	status = "disabled";
};

&pinctrl {
	spim2_pmw3901: spim2_pmw3901 {
		group1 {
			pinmux = <SPIM2_MISO_GPIO18>,
				 <SPIM2_SCLK_GPIO6>,
				 <SPIM2_CSEL_GPIO10>;
		};

		group2 {
			pinmux = <SPIM2_MOSI_GPIO7>;
			output-low;
		};
	};
};

&spi2 {
	status = "okay";
	pinctrl-0 = <&spim2_pmw3901>;
	pinctrl-names = "default";
};