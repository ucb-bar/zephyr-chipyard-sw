/* RoSE co-sim overlay for the fused-vision nav controller (M1 transport).
 *
 * Command IDs / reqrsp channels match config_gym_WarehouseFusedNavBridgeEnv-v0.yaml:
 *   - 0x11 DMA ch0 : front_grey int8[5400] served as a GREY 90x60 "frame" (5400 B).
 *   - 0x41 reqrsp  : tof_cross int8[256]  (channel 1) — read raw by the app.
 *   - 0x42 reqrsp  : lowdim float32[21]   (channel 2) — read raw by the app.
 *   - 0x20 action  : (yaw_rate, forward_speed) float32[2] guest->Isaac.
 * The 0x41/0x42 reqrsp reads are issued directly on the adapter (no per-sensor DT node).
 */
/ {
	rose0: rose@2000 {
		compatible = "ucbbar,RoseAdapter";
		reg = <0x2000 0x1000>;
		interrupt-parent = <&plic>;
		interrupts = <3 1>;
		num-reqrsp-channels = <2>;
		num-dma-channels = <1>;
		/* DMA landing zone ABOVE the 256 MB guest SRAM; matches
		 * run_spike_rose_lockstep.sh --rose-dma-base (default 0x90000000). */
		dma-base-address = <0x90000000>;
		status = "okay";
	};

	/* Pre-quantized int8 front_grey (60x90) delivered as a GREY (1 B/px) 90x60 frame
	 * over the bridge DMA path (cmd 0x11, DMA ch0) = 5400 bytes. The app reinterprets
	 * the delivered bytes as int8 model input0. */
	rose_cam: rose-cam {
		compatible = "ucbbar,rose-camera";
		rose = <&rose0>;
		rose-cmd = <0x11>;
		dma-channel = <0>;
		width = <90>;
		height = <60>;
		status = "okay";
	};

	aliases {
		fpv = &rose_cam;
	};
};
